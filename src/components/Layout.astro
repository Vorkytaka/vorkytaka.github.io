---
import "../styles/global.css";
import SEO from "./SEO.astro";
import type { PageMeta } from '../config/site';

interface Props extends Partial<PageMeta> {
  lang?: string;
  class?: string;
  containerClass?: string;
  path?: string;
}

const { 
  lang = 'ru',
  class: bodyClass = "",
  containerClass = "container",
  path,
  ...seoProps
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <SEO {...seoProps} path={path} />
  </head>
  <body class={bodyClass}>
    <main class={containerClass}>
      <slot />
    </main>
  </body>
</html>
