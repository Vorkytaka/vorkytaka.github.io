---
import PageTemplate from "../components/PageTemplate.astro";

// Change to static rendering for GitHub Pages compatibility
export const prerender = true;
---
<PageTemplate 
  title="404"
  description="Страница не найдена"
  headerTitle="40"
  headerSubtitle="4"
  path="/404"
>
  <p>Страница не найдена</p>
  <p>Страница, которую вы ищете, не существует или была перемещена.</p>

  <div class="terminal-links" role="navigation" aria-label="Navigation">
    <ul>
      <li>
        <a href="/">
          <span class="primary">→</span>
          <span>На главную</span>
        </a>
      </li>
    </ul>
  </div>
</PageTemplate>

<style>
  /* Additional styles specific to 404 page */
  h1 .primary,
  h1 .darker {
    font-size: 3rem;
  }
  
  .terminal-links a .primary {
    margin-right: 0.5rem;
  }
</style>